# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=your-database-id
VITE_APPWRITE_BEACONS_TABLE_ID=beacons
VITE_APPWRITE_CLAIMS_TABLE_ID=claims
VITE_APPWRITE_EVENTS_TABLE_ID=events
VITE_APPWRITE_SUPPLIES_TABLE_ID=supplies

# Appwrite Function IDs (public identifiers)
VITE_APPWRITE_FUNCTION_CLAIM_ID=your-claim-function-id
VITE_APPWRITE_FUNCTION_RESET_ID=your-reset-function-id

# Optional: Map configuration
VITE_MAP_DEFAULT_LAT=37.7749
VITE_MAP_DEFAULT_LNG=-122.4194
VITE_MAP_DEFAULT_ZOOM=10