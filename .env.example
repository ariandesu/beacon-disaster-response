# Appwrite Configuration (browser-safe values only)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=your-database-id
VITE_APPWRITE_BEACONS_TABLE_ID=beacons
VITE_APPWRITE_CLAIMS_TABLE_ID=claims
VITE_APPWRITE_EVENTS_TABLE_ID=events
VITE_APPWRITE_SUPPLIES_TABLE_ID=supplies

# Appwrite Function IDs (public identifiers; the app also has safe defaults)
# claim-beacon is an operations router: the browser sends
# action=claim | resolve | updateSupply in the execution body.
VITE_APPWRITE_FUNCTION_CLAIM_ID=claim-beacon
VITE_APPWRITE_FUNCTION_RESOLVE_ID=claim-beacon
VITE_APPWRITE_FUNCTION_RESET_ID=reset-demo
VITE_APPWRITE_FUNCTION_UPDATE_SUPPLY_ID=claim-beacon

# Optional: Map configuration
VITE_MAP_DEFAULT_LAT=37.7749
VITE_MAP_DEFAULT_LNG=-122.4194
VITE_MAP_DEFAULT_ZOOM=10

# -----------------------------------------------------------------------------
# Server-only settings are configured in the Appwrite Console, NOT here.
# Each Function gets:
#   APPWRITE_ENDPOINT, APPWRITE_PROJECT_ID, APPWRITE_DATABASE_ID,
#   APPWRITE_BEACONS_TABLE_ID, APPWRITE_CLAIMS_TABLE_ID,
#   APPWRITE_EVENTS_TABLE_ID, APPWRITE_SUPPLIES_TABLE_ID
#   ADMIN_EMAILS (optional comma-separated bootstrap fallback; prefer the
#   `admin` user label)
# The deployed Functions use a server-only APPWRITE_API_KEY or
# APPWRITE_FUNCTION_API_KEY with database/document read-write and users.read
# scopes. Never expose either key to the browser.
# -----------------------------------------------------------------------------
